# Optional Azure OpenAI v1 API configuration.
# Endpoint is the Azure OpenAI resource root, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Optional for local experimentation. Prefer Microsoft Entra ID when possible.
AZURE_OPENAI_API_KEY=

# Set to production when running in Azure with a managed identity.
# Local development defaults to DefaultAzureCredential (for example, az login).
APP_ENV=development
